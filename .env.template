# =============================================================================
# .env.template — Committed to git. Safe to share.
#
# Setup:
#   cp .env.template .env
#   Fill in your own values in .env
#   The .env file is gitignored — never commit it.
# =============================================================================

# ------------------------------------------------------------------------------
# Neon PostgreSQL
# Get this from your Neon dashboard: Project → Connection Details
# Format: Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require
# ------------------------------------------------------------------------------
NEON_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# JWT
# SecretKey must be at least 32 characters long
# Issuer and Audience should match what you have in appsettings.json
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ISSUER=EduCheck
JWT_AUDIENCE=EduCheck
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ------------------------------------------------------------------------------
# Grafana Cloud / OpenTelemetry
# Get these from your Grafana Cloud stack → Connections → OpenTelemetry
# Endpoint format: https://otlp-gateway-<region>.grafana.net/otlp
# Headers format:  Authorization=Basic <base64(instanceId:token)>
# ------------------------------------------------------------------------------
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_HEADERS=