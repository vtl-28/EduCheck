# =============================================================================
# .dockerignore
# Prevents unnecessary files from being sent to the Docker build context.
# A smaller build context = faster builds.
# Place this file at the solution root alongside EduCheck.sln
# =============================================================================

# Build output — generated by the SDK inside the container, not needed from host
**/bin/
**/obj/

# Git
.git/
.gitignore

# IDE and editor files
.vs/
.vscode/
*.user
*.suo

# Test projects — never included in the production image
EduCheck.Tests/
EduCheck.IntegrationTests/

# Local secrets and environment files — NEVER bake into image
.env
run-dev.sh
*.secret
*.token

# Documentation
**/*.md
docs/

# Node (if frontend is ever added alongside)
**/node_modules/

# Docker files themselves (no need to copy into the build context)
docker-compose*.yml
**/Dockerfile*

# OS files
.DS_Store
Thumbs.db